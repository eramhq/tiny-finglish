{
  "name": "tiny-finglish",
  "version": "0.1.0",
  "description": "Finglish (Persian typed in Latin/ASCII) to Persian script, entirely in the browser. No server, no API key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eramhq/tiny-finglish.git"
  },
  "homepage": "https://eramhq.github.io/tiny-finglish/",
  "bugs": {
    "url": "https://github.com/eramhq/tiny-finglish/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules-engine.d.ts",
      "import": "./dist/rules-engine.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "import": "./dist/normalize.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./weights.json": "./dist/data/weights.json",
    "./frequency.bin": "./dist/data/frequency.bin",
    "./vowels.bin": "./dist/data/vowels.bin"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node --experimental-strip-types scripts/package-data.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node --experimental-strip-types scripts/run-fixtures.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "size": "node --experimental-strip-types scripts/size.ts",
    "compare": "node --experimental-strip-types scripts/compare.ts",
    "parity": "node --experimental-strip-types scripts/parity.ts",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "oracle": "node --experimental-strip-types scripts/oracle.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "farsi-smart-assistant": "github:FarsioIR/NeveshtYar#v4.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
